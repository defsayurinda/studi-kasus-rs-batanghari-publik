{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "E:/Arsip/Kuliah",
      "C:/Users/Defsa/Downloads/Semster 7"
    ],
    "deny": [
      "Edit(//e/Arsip/Kuliah/**)",
      "Write(//e/Arsip/Kuliah/**)"
    ]
  },
  "enabledMcpjsonServers": [
    "bimcraft"
  ],
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Defsa/AppData/Local/Programs/Python/Python312/Scripts/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Defsa/AppData/Local/Programs/Python/Python312/Scripts/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Defsa/AppData/Local/Programs/Python/Python312/Scripts/graphify.EXE hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}